# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Note: Updated Unity .gitignore with additional patterns for XR/ML projects

# Unity Core Files
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log

# Memory captures and recordings (can be large/sensitive)
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity Generated Files
*.pidb
*.svd
*.tmp
*.utmp

# Mono crash files
mono_crash.*

# Unity Packages
*.unitypackage
*.unitypackage.meta

# Blender imports
*.blend1
*.blend1.meta

